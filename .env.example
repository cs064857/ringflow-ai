# PI Agent 模型與環境變數設定
# 支援原生音訊分析 (Native Audio Understanding) 的模型：
# - google: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro (原生支援聽音分析，強烈推薦)
# - openai: gpt-4o-audio-preview
# - custom: 相容 OpenAI / Gemini 格式之多模態端點

PI_AGENT_PROVIDER=google
PI_AGENT_MODEL=gemini-2.0-flash
PI_AGENT_API_KEY=
PI_AGENT_BASE_URL=https://generativelanguage.googleapis.com

# 伺服器連接埠設定
PORT=3005

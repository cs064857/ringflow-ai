              startSec: 185,
              endSec: 214.5,
              lyricsHighlight: "\u8AE6\u3081\u306A\u3044\u9650\u308A Life is a chance / \u7121\u6557\u306E\u6311\u6226\u8005...",
              description: "\u96FB\u5409\u4ED6 Solo \u5F8C\u7684\u6700\u7D42\u6607\u83EF\u7248\u526F\u6B4C\uFF0C\u65CB\u5F8B\u958B\u95CA\u71B1\u8840\uFF0C\u5145\u6EFF\u5E0C\u671B\u8207\u6FC0\u52F5\u611F\u3002",
